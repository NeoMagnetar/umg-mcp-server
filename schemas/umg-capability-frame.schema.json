{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "umg-capability-frame",
  "title": "UMG Capability Frame Schema",
  "description": "Per-response description of the active modular cognitive mind. v0.2 ships pre_response (prospective) frame only. Schema room exists for post_response_trace. Generated by composeCapabilityFrame() pass from RuntimeSpec.",
  "version": "0.2.0",

  "type": "object",
  "required": ["frame_id", "kind", "response_scope", "active_sleeve", "dominant_directive"],
  "properties": {

    "frame_id": {
      "type": "string",
      "description": "Unique frame identifier. Convention: FRAME-{runtime_id}-{turn_index}."
    },

    "kind": {
      "type": "string",
      "enum": ["pre_response", "post_response_trace"],
      "description": "pre_response: generated before response — describes intended active mind. post_response_trace: generated after — audits what actually happened. v0.2 implements pre_response only.",
      "default": "pre_response"
    },

    "response_scope": {
      "type": "string",
      "enum": ["single_response", "session", "sleeve_default"],
      "description": "single_response: frame applies to this response only. session: frame persists across the session. sleeve_default: frame represents the sleeve baseline.",
      "default": "single_response"
    },

    "active_sleeve": {
      "type": "string",
      "description": "sleeve_id of the active sleeve for this frame."
    },

    "session_id": {
      "type": ["string", "null"],
      "description": "Session identifier. Null when stateless."
    },

    "turn_index": {
      "type": ["integer", "null"],
      "description": "Turn count within session."
    },

    "active_neostacks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of active NeoStacks contributing to this frame."
    },

    "active_bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bundle_id": { "type": "string" },
          "bundle_name": { "type": "string" },
          "expanded_into": { "type": "array", "items": { "type": "string" } }
        }
      },
      "description": "Bundles expanded and active in this frame."
    },

    "active_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lane_id": {
            "type": "string",
            "enum": ["analysis", "planning", "creative", "audit", "tooling", "memory", "output"]
          },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "activated_by": { "type": "array", "items": { "type": "string" } }
        }
      },
      "description": "Horizontal capability lanes active for this response."
    },

    "dominant_directive": {
      "type": "string",
      "description": "Block name of the governing Directive in this frame. The primary behavioral authority."
    },

    "dominant_instruction": {
      "type": ["string", "null"],
      "description": "Block name of the governing Instruction."
    },

    "primary_subject": {
      "type": ["string", "null"],
      "description": "Block name of the primary Subject — what this response is about."
    },

    "dominant_primary": {
      "type": ["string", "null"],
      "description": "Block name of the dominant Primary outcome value."
    },

    "dominant_philosophy": {
      "type": ["string", "null"],
      "description": "Block name of the active philosophical lens, if any."
    },

    "output_blueprint": {
      "type": "object",
      "description": "Resolved output format for this response.",
      "properties": {
        "blueprint_type": {
          "type": "string",
          "description": "The resolved Blueprint block name or OutputComposite type_id."
        },
        "is_composite": {
          "type": "boolean",
          "description": "True if the output blueprint is a declared OutputComposite."
        },
        "source_lanes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lanes that contributed to this output blueprint."
        }
      }
    },

    "tool_policy": {
      "type": "object",
      "description": "Tool usage constraints active for this frame.",
      "properties": {
        "tools_available": {
          "type": "array",
          "items": { "type": "string" },
          "description": "MCP tools or capability IDs available in this frame."
        },
        "tools_restricted": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools explicitly restricted by governance blocks in this frame."
        },
        "escalation_required_for": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Actions requiring MAG escalation before execution."
        }
      }
    },

    "merge_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "merge_id": { "type": "string" },
          "merged_molt_type": { "type": "string" },
          "coherence_status": { "type": "string" },
          "dominant_block": { "type": "string" }
        }
      },
      "description": "Summary of merges active in this frame."
    },

    "suppression_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "suppression_reason": { "type": "string" }
        }
      },
      "description": "Summary of suppressed stacks, blocks, or bundles and why."
    },

    "runtime_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Resolver-generated notes about this frame. Warnings, observations, sovereign review flags."
    },

    "post_response_trace": {
      "type": "object",
      "description": "Reserved for post_response_trace kind. Not implemented in v0.2.",
      "properties": {
        "blocks_invoked": { "type": "array", "items": { "type": "string" } },
        "lanes_invoked": { "type": "array", "items": { "type": "string" } },
        "deviations_from_pre_frame": { "type": "array", "items": { "type": "string" } },
        "audit_status": { "type": "string", "enum": ["clean", "deviation_noted", "conflict_occurred"] }
      }
    }
  },

  "laneDefinitions": {
    "analysis": {
      "description": "Decomposition, reasoning, structural breakdown of a subject.",
      "typical_blocks": ["Assess Accurately", "Break Into Components", "Identify Root Causes", "Reveal Patterns"],
      "conflicts_with": ["creative_at_blueprint_level"]
    },
    "planning": {
      "description": "Steps, sequencing, roadmap, milestone definition.",
      "typical_blocks": ["Define Milestones", "Sequence Tasks", "Think Long Term", "Establish Timeline"],
      "conflicts_with": []
    },
    "creative": {
      "description": "Generation, ideation, naming, possibility space.",
      "typical_blocks": ["Generate Novelty", "Express Authentically", "Innovate Practically", "Design Elegantly"],
      "conflicts_with": ["analysis_at_blueprint_level"]
    },
    "audit": {
      "description": "Validation, contradiction detection, gap identification, compliance check.",
      "typical_blocks": ["Check Against Requirements", "Verify Claims", "Identify Weaknesses", "Report Violations"],
      "conflicts_with": []
    },
    "tooling": {
      "description": "Tool choice, execution planning, MCP orchestration.",
      "typical_blocks": ["Stack Blocks Hierarchically", "Coordinate With Mesh", "Verify Tool Anchor"],
      "conflicts_with": []
    },
    "memory": {
      "description": "Continuity, prior state, session context, project history.",
      "typical_blocks": ["Track Continuity", "Preserve Useful Knowledge", "Respect Context"],
      "conflicts_with": []
    },
    "output": {
      "description": "Format, presentation, export, blueprint selection.",
      "typical_blocks": ["Be Complete When Needed", "Be Concise When Useful", "Adapt To Audience"],
      "conflicts_with": []
    }
  },

  "examples": [
    {
      "frame_id": "FRAME-RT-1779478663-001",
      "kind": "pre_response",
      "response_scope": "single_response",
      "active_sleeve": "OG_ENVOY_SESSION.v1",
      "session_id": null,
      "turn_index": null,
      "active_neostacks": ["Governance Core", "Tool Orchestration"],
      "active_bundles": [
        {
          "bundle_id": "BUNDLE_GOVERNANCE_CORE",
          "bundle_name": "Sovereign Governance Core",
          "expanded_into": ["NB-Tool Anchor Ethos"]
        }
      ],
      "active_lanes": [
        { "lane_id": "tooling", "weight": 0.9, "activated_by": ["framework_development_request"] },
        { "lane_id": "audit", "weight": 0.7, "activated_by": ["governance_review"] },
        { "lane_id": "output", "weight": 0.6, "activated_by": ["output_required"] }
      ],
      "dominant_directive": "Honor Governance",
      "dominant_instruction": "Stack Blocks Hierarchically",
      "primary_subject": "NeoBlocks",
      "dominant_primary": "Human Sovereignty",
      "dominant_philosophy": "Deontology",
      "output_blueprint": {
        "blueprint_type": "Markdown",
        "is_composite": false,
        "source_lanes": ["output"]
      },
      "tool_policy": {
        "tools_available": ["umg_resolve_runtime", "umg_generate_molt_map", "umg_generate_ir_graph"],
        "tools_restricted": [],
        "escalation_required_for": ["registry_modification", "canonical_block_promotion"]
      },
      "merge_summary": [],
      "suppression_summary": [
        { "id": "NS-Analytical Partnership", "suppression_reason": "trigger_mismatch" }
      ],
      "runtime_notes": [
        "Session state is not active — turn_index and previous_runtime_id are null.",
        "Sovereign review required per provenance flag on this session-compiled sleeve."
      ]
    }
  ]
}
