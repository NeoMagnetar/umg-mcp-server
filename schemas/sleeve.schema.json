{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UMG Sleeve",
  "description": "A governed UMG cognitive sleeve — modular architecture for AI cognition.",
  "type": "object",
  "required": ["sleeve_name", "neoStacks"],
  "properties": {
    "sleeve_id":   { "type": "string" },
    "sleeve_name": { "type": "string" },
    "version":     { "type": "string" },
    "reasoning":   { "type": "string", "description": "Design rationale" },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceMode":            { "type": "string", "enum": ["compiled_by_claude","compiled_by_ai","library","session","candidate"] },
        "routePurity":           { "type": "string" },
        "sovereignReviewRequired": { "type": "boolean" },
        "compiledAt":            { "type": "string", "format": "date-time" }
      }
    },
    "neoStacks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "neoBlocks"],
        "properties": {
          "id":   { "type": "string" },
          "name": { "type": "string" },
          "gates": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "id":   { "type": "string" },
                "type": { "type": "string", "const": "TRIGGER" },
                "name": { "type": "string" }
              }
            }
          },
          "neoBlocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["name", "blocks"],
              "properties": {
                "id":   { "type": "string" },
                "name": { "type": "string" },
                "blocks": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 5,
                  "items": {
                    "type": "object",
                    "required": ["type", "name"],
                    "properties": {
                      "id":   { "type": "string" },
                      "type": { "type": "string", "enum": ["DIRECTIVE","INSTRUCTION","SUBJECT","PRIMARY","PHILOSOPHY","BLUEPRINT","PERSONA"] },
                      "name": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
